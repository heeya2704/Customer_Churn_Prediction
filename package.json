{
  "name": "customer-churn-prediction",
  "version": "1.0.0",
  "private": true,
  "description": "Telecom customer churn prediction — React frontend + FastAPI/ML backend deployed as a single Vercel project.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/py.mjs -m uvicorn app.main:app --reload --reload-dir app --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "install:frontend": "cd frontend && npm install",
    "build": "cd frontend && npm install && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/py.mjs -m pytest",
    "test:frontend": "cd frontend && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
