# Frontend environment configuration (optional).
#
# The app uses relative "/api/*" paths by default, which work on Vercel (same
# domain) and in local dev (via the Vite proxy to http://localhost:8000).
#
# Only set VITE_API_URL if you need to point the frontend at a backend hosted
# on a DIFFERENT origin, e.g. a standalone API server:
# VITE_API_URL=https://your-api-host.example.com

# Optional: override the local dev proxy target (defaults to localhost:8000).
# VITE_DEV_API_PROXY=http://localhost:8000
