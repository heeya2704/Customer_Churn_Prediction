# Backend / API environment configuration.
# Copy to .env for local development (python-dotenv loads it automatically).
# On Vercel, set any of these in the project's Environment Variables settings.

APP_NAME=Churn Prediction API
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS is only needed when the frontend is served from a DIFFERENT origin than
# the API. In the single-domain Vercel setup the frontend uses same-origin
# relative "/api" requests, so CORS is not exercised in production.
# For local dev with the Vite dev server:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional path overrides (defaults are derived from the project layout):
# MODEL_DIR=./model
# DATA_PATH=./data/telco_churn.csv
